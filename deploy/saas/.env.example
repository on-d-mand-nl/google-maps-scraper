# Central configuration: save as .env. Generate both secrets with openssl rand -hex 32.
TAILSCALE_IP=100.x.y.z
POSTGRES_PASSWORD=
ENCRYPTION_KEY=
# Worker configuration: save DATABASE_URL in .env.worker on each worker.
# Traffic must use Tailscale, which encrypts the connection.
# DATABASE_URL=postgres://gmapssaas:PASSWORD@100.x.y.z:55432/gmapssaas?sslmode=disable
